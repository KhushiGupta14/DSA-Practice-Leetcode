class Solution {
    public int[] findThePrefixCommonArray(int[] a, int[] b) {
        int n = a.length;

        int []f = new int[n + 1];
        int []ans = new int[n];

        int common = 0;

        for(int i = 0; i < n; i++){

            f[a[i]]++;

            if(f[a[i]] == 2)
                common++;

            f[b[i]]++;

            if(f[b[i]] == 2)
                common++;

            ans[i] = common;
        }
        return ans;
    }
}
