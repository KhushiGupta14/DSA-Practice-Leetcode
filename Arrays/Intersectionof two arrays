class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        HashSet<Integer> set = new HashSet<>();
        HashSet<Integer> set2 = new HashSet<>();


        for(int x : nums1){
            set.add(x);
        }


         for(int x : nums2){
            if(set.contains(x))
                set2.add(x);
        }
        
        int []res = new int[set2.size()];
        int i = 0;
        for(int x : set2){
            res[i++] = x;
        }
        return res;
    }
}
