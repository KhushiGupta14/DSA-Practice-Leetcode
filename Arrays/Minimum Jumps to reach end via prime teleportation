import java.util.*;

class Solution {
    public int minJumps(int[] nums) {
        int n = nums.length;
        if (n <= 1) return 0;
        
        // Step 1: Find the max value to size our Sieve
        int maxVal = 0;
        for (int num : nums) {
            maxVal = Math.max(maxVal, num);
        }
        
        // Step 2: Sieve of Eratosthenes to find Smallest Prime Factors (SPF)
        int[] spf = new int[maxVal + 1];
        for (int i = 2; i <= maxVal; i++) {
            spf[i] = i;
        }
        for (int i = 2; i * i <= maxVal; i++) {
            if (spf[i] == i) {
                for (int j = i * i; j <= maxVal; j += i) {
                    if (spf[j] == j) {
                        spf[j] = i; // Mark the smallest prime factor
                    }
                }
            }
        }
        
        boolean[] isPrimeInNums = new boolean[maxVal + 1];
        for (int num : nums) {
            if (num >= 2 && spf[num] == num) {
                isPrimeInNums[num] = true;
            }
        }
        
        // Step 4: Map each valid prime to the indices that are multiples of it
        List<Integer>[] primeToIndices = new ArrayList[maxVal + 1];
        for (int i = 0; i < n; i++) {
            int temp = nums[i];
            
            // Rapidly extract distinct prime factors using the SPF array
            while (temp > 1) {
                int p = spf[temp];
                
                // If this prime can actually be used as a teleport source, record this index
                if (isPrimeInNums[p]) {
                    if (primeToIndices[p] == null) {
                        primeToIndices[p] = new ArrayList<>();
                    }
                    primeToIndices[p].add(i);
                }
                
                // Divide out all occurrences of this prime factor
                while (temp % p == 0) {
                    temp /= p;
                }
            }
        }
        
        // Step 5: BFS to find the shortest path
        boolean[] visited = new boolean[n];
        boolean[] visitedPrime = new boolean[maxVal + 1];
        Queue<Integer> queue = new LinkedList<>();
        
        queue.offer(0);
        visited[0] = true;
        int jumps = 0;
        
        while (!queue.isEmpty()) {
            int size = queue.size();
            
            for (int i = 0; i < size; i++) {
                int curr = queue.poll();
                
                // Base Case: We reached the end
                if (curr == n - 1) {
                    return jumps;
                }
                
                // Move 1: Adjacent steps
                if (curr + 1 < n && !visited[curr + 1]) {
                    visited[curr + 1] = true;
                    queue.offer(curr + 1);
                }
                if (curr - 1 >= 0 && !visited[curr - 1]) {
                    visited[curr - 1] = true;
                    queue.offer(curr - 1);
                }
                
                // Move 2: Prime Teleportation
                int num = nums[curr];
                if (num >= 2 && spf[num] == num) { // Check if the current number is a prime
                    if (!visitedPrime[num]) {
                        visitedPrime[num] = true; // Never teleport from this prime again
                        
                        if (primeToIndices[num] != null) {
                            for (int nextIdx : primeToIndices[num]) {
                                if (!visited[nextIdx]) {
                                    visited[nextIdx] = true;
                                    queue.offer(nextIdx);
                                }
                            }
                        }
                    }
                }
            }
            jumps++; 
        }
        
        return -1; 
    }
}
