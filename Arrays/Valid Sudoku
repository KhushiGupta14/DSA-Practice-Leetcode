class Solution {
    public boolean isValidSudoku(char[][] board) {
        boolean rows[][] = new boolean[9][9];
        boolean cols[][] = new boolean[9][9];
        boolean boxes[][] = new boolean[9][9];

        for(int r = 0; r < 9; r++){
            for(int c = 0; c < 9; c++){
                char val = board[r][c];

                if(val == '.')
                    continue;

                int indx = val - '1';

                int box = (r / 3) * 3 + (c / 3);

                if(rows[r][indx] || cols[c][indx] || boxes[box][indx])
                    return false;

                rows[r][indx] = true;
                cols[c][indx] = true;
                boxes[box][indx] = true;
            }
        }
        return true;
    }
}
