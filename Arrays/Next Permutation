class Solution {
    public void nextPermutation(int[] nums) {
        int n = nums.length;
        int i = 0;
        for (i = n - 2; i >= 0; i--) {
            if (nums[i] < nums[i + 1]) {
                int j = n - 1;
                while (j >= 0 && nums[j] <= nums[i]) {
                    j--;
                }

                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
                break;
            }
        }

        reverse(nums,i+1,n-1);
    }

    public void reverse(int[] nums, int i, int j) {
        while (i < j) {
            int temp = nums[i];
            nums[i] = nums[j];
            nums[j] = temp;
            i++;
            j--;
        }
    }
}
