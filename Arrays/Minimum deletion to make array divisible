class Solution {
    public int minOperations(int[] nums, int[] numsDivide) {
        int g = numsDivide[0];

        Arrays.sort(nums);
        
        for(int i = 1; i < numsDivide.length;i++){
            g = gcd(g,numsDivide[i]);
        }
            
        for(int i = 0; i < nums.length;i++){
            if(g % nums[i] == 0) 
                return i;
        }
        return -1;
    }

    private int gcd(int a, int b){
        return (b == 0)? a: gcd(b, a % b);
    }
}
