class Solution {
    public int maxRotateFunction(int[] nums) {
        int n = nums.length;
        int sum = 0;
        int f0 = 0;
        for(int i = 0; i < n; i++){
            sum += nums[i];
            f0 += i * nums[i];
        }

        int curr = f0;
        int max = f0;

        for(int i = 1; i < n; i++){
            curr = curr + sum - n * nums[n - i];
            max = Math.max(max,curr);
        }
        return max;
    }
}
