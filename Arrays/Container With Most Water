class Solution {
    public int maxArea(int[] height) {
int left = 0;
        int right = height.length - 1;

        int maxWaterAmt = 0;

        while(left < right){
            int x = right - left;
            int y = Math.min(height[left], height[right]);

            int currArea = x * y;
            if(currArea > maxWaterAmt){
                maxWaterAmt = currArea;
            }
            if(height[left] < height[right]) { 
                left++;
            } 
            else {
                right--;
            }

        }

        return maxWaterAmt;
    }
}
