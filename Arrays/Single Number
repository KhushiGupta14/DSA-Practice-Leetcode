class Solution {
    public int singleNumber(int[] nums) {
        Arrays.sort(nums);
        int singleOccuranceNo=-1;
    for(int i=0;i<nums.length;i=i+2)
        {
            if( i+1<nums.length){
                if(nums[i]==nums[i+1])
                    continue;
                 else{
                    singleOccuranceNo=nums[i];
                    break;
                 }
            }
            else
                singleOccuranceNo=nums[nums.length-1];
        }
        return  singleOccuranceNo;
    }
}
