class Solution {
    public int findNumberOfLIS(int[] nums) {
        int n = nums.length;
        
        int[] len = new int[n];
        int[] count = new int[n];
        
        Arrays.fill(len, 1);
        Arrays.fill(count, 1);
        
        int maxLength = 1;
        
        for(int i = 0; i < n; i++){
            for(int j = 0; j < i; j++){
                if(nums[i] > nums[j]){
                    if(len[j] + 1 > len[i]){
                        len[i] = len[j] + 1;
                        count[i] = count[j];
                    }
                    else if(len[j] + 1 == len[i]){
                        count[i] += count[j];
                    }
                }
            }
            maxLength = Math.max(maxLength, len[i]);
        }
        
        int c = 0;
        for(int i = 0; i < n; i++){
            if(len[i] == maxLength)
                c += count[i];
        }
        
        return c;
    }
}
