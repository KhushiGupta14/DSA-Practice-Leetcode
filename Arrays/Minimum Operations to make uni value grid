class Solution {
    public int minOperations(int[][] grid, int x) {
        int n = grid.length;
        int m = grid[0].length;

        int []arr = new int[m * n];

        int k = 0;

        for(int i = 0; i < n; i++)
            for(int j = 0; j < m; j++)
                arr[k++] = grid[i][j];

        int rem = arr[0] % x;
        for(int num : arr){
            if(num % x != rem)
                return -1;
        }

        Arrays.sort(arr);

        int mid = arr[(arr.length - 1) / 2];

        int op = 0;
        for(int num :arr){
            op += Math.abs(num - mid) / x;
        }
        return op;
    }
}
